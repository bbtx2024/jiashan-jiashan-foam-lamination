<Window x:Class="QA.IntelligentEquipment.Views.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:fa5="http://schemas.fontawesome.com/icons/"    
        xmlns:cal="http://www.caliburnproject.org"
        xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
        xmlns:local="clr-namespace:QA.IntelligentEquipment.Views"
        xmlns:convert="clr-namespace:QA.IntelligentEquipment.Converters"
        xmlns:convert1="clr-namespace:QA.Business.Converts;assembly=QA.Business"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        
        Title="{Binding Title}" 
        Height="800" 
        Width="1440"
        MinHeight="800"
        MinWidth="1440"
        WindowState="{Binding WindowState}" 
        WindowStyle="None" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
       >
    <!--xmlns:uc="clr-namespace:QA.UserControls;assembly=QA.UserControls"-->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QA.IntelligentEquipment;component/Styles/MenuItemStyle.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/QA.IntelligentEquipment;component/Styles/TreeViewStyle.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/QA.IntelligentEquipment;component/Styles/ToggleButtonStyle.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/QA.IntelligentEquipment;component/Styles/NavigateStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <RoutedUICommand x:Key="TestFunction1"/>
            <RoutedUICommand x:Key="TestFunction2"/>
            <RoutedUICommand x:Key="UpdateHotket"/>

            <convert:AlarmChangeColorConvert x:Key="AlarmChangeColorConvert"/>
            <convert:AutoRunChangeColorConvert x:Key="AutoRunChangeColorConvert"/>
            <convert1:HiveStatusToColorConvert x:Key="HiveStatusToColorConvert"/>
            <convert1:HiveStatusToStringConvert x:Key="HiveStatusToStringConvert"/>
            <convert1:HiveStatusToTopColorConvert x:Key="HiveStatusToTopColorConvert"/>

        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+T" Command="{StaticResource TestFunction1}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{StaticResource TestFunction2}"/>
        <KeyBinding Gesture="Ctrl+Alt+U" Command="{StaticResource UpdateHotket}"/>
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="{StaticResource TestFunction1}" CanExecute="ShotcutKey_TestFunction1"/>
        <CommandBinding Command="{StaticResource TestFunction2}" CanExecute="ShotcutKey_TestFunction2"/>
        <CommandBinding Command="{StaticResource UpdateHotket}" CanExecute="ShotcutKey_UpdateFireware"/>
    </Window.CommandBindings>

    <Border BorderThickness="1" BorderBrush="LightGray" materialDesign:ShadowAssist.ShadowDepth="Depth5" materialDesign:ShadowAssist.Darken="True" materialDesign:ShadowAssist.ShadowEdges="All">
        <Grid Background="#008d86">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="26"></RowDefinition>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" MouseDown="Shell_OnMouseDown"
                  Background="{Binding HiveStatus, Converter={StaticResource HiveStatusToColorConvert}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MinWidth="120"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" Background="Transparent">
                    <RadioButton Content="&#xe65d;" FontSize="48"
                                     Width="70" Height="70" Padding="11,10,0,0" GroupName="NaviGroup" ToolTip="主页"
                                     Style="{DynamicResource NavigateButtonStyle2}" IsChecked="True"
                                     cal:Message.Attach="[Event Click] = [Action NavigatePage('MainFormPageViewModel')]"/>

                    <RadioButton Content="&#xe679;" Tag="SetupPageViewModel" FontSize="46"
                                     Width="70" Height="70" Padding="12,12,0,0" GroupName="NaviGroup" ToolTip="设置"
                                     Style="{DynamicResource NavigateButtonStyle2}"
                                     cal:Message.Attach="[Event Click] = [Action NavigatePage('SetupPageViewModel')]"/>

                    <RadioButton Content="&#xe609;" Tag="CCDPageViewModel" FontSize="48"
                                     Width="70" Height="70" Padding="11,12,0,0" GroupName="NaviGroup" ToolTip="相机"
                                     Style="{DynamicResource NavigateButtonStyle2}"
                                     cal:Message.Attach="[Event Click] = [Action NavigatePage('CCDPageViewModel')]"/>

                    <RadioButton Content="&#xe871;" Tag="AlarmPageViewModel" FontSize="46"
                                     Width="70" Height="70" Padding="12,10,0,0" GroupName="NaviGroup" ToolTip="报警"
                                     Style="{DynamicResource NavigateButtonStyle2}" Foreground="{Binding IsHaveAlarm,Converter={StaticResource AlarmChangeColorConvert}}"
                                     cal:Message.Attach="[Event Click] = [Action NavigatePage('AlarmPageViewModel')]"/>

                    <RadioButton Content="&#xe6f2;" Tag="ProductivityPageViewModel" FontSize="48"
                                     Width="70" Height="70" Padding="11,13,0,0" GroupName="NaviGroup" ToolTip="产能"
                                     Style="{DynamicResource NavigateButtonStyle2}"
                                     cal:Message.Attach="[Event Click] = [Action NavigatePage('ProductivityPageViewModel')]"/>

                    <TextBlock Text="{Binding TaskName}" FontSize="28" Height="70" Padding="10,24"
                                   Style="{DynamicResource NavigateTextStyle}"
                                   cal:Message.Attach="[Event MouseLeftButtonDown] = [Action BtnSelectTask]"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Background="Transparent">
                    <TextBlock x:Name="tbStart" Text="&#xF04B;" Tag="Run" FontSize="44"
                                   Width="70" Height="70" Padding="0,14,0,0"
                                   Style="{StaticResource NavigateTextStyle}"
                                   Foreground="{Binding IsAutoRun,Converter={StaticResource AutoRunChangeColorConvert}}"
                                   cal:Message.Attach="[Event MouseLeftButtonDown]=[Action Start]"/>

                    <TextBlock x:Name="tbPause" Text="&#xF04C;" Tag="Pause" FontSize="44"
                                   Width="70" Height="70" Padding="0,14,0,0"
                                   Style="{StaticResource NavigateTextStyle}"
                                   cal:Message.Attach="[Event MouseLeftButtonDown]=[Action Pause]"/>

                    <TextBlock x:Name="tbStop" Text="&#xea90;" Tag="Reset" FontSize="54"
                                   Width="70" Height="70" Padding="0,10,0,0"
                                   Style="{StaticResource NavigateTextStyle2}"
                                   cal:Message.Attach="[Event MouseLeftButtonDown]=[Action Stop]"/>

                    <!--<TextBlock Height="70" Padding="15,22,15,0"
                                   Text="{Binding GlobalVariableProperty.WorkMode, Converter={StaticResource WorkModelToStringConvert}}"
                                   Style="{DynamicResource WorkModeTextBlockStyle}"
                                   cal:Message.Attach="[Event MouseLeftButtonDown]=[Action ChangeWorkMode]">
                    </TextBlock>-->
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Background="Transparent">
                    <TextBlock Text="&#xF1c5;" FontSize="38"
                                     Width="70" Height="70" Padding="0,17,0,0" ToolTip="图片"
                                     Style="{DynamicResource NavigateTextStyle}"
                                     cal:Message.Attach="[Event MouseLeftButtonDown]=[Action OpenImgDir]"/>

                    <TextBlock Text="&#xF1c3;" FontSize="38"
                                     Width="70" Height="70" Padding="0,17,0,0" ToolTip="表格"
                                     Style="{DynamicResource NavigateTextStyle}" 
                                     cal:Message.Attach="[Event MouseLeftButtonDown]=[Action OpenCsvDir]"/>

                    <TextBlock Text="&#xF1c6;" FontSize="38"
                                     Width="70" Height="70" Padding="0,17,0,0" ToolTip="日志"
                                     Style="{DynamicResource NavigateTextStyle}"
                                     cal:Message.Attach="[Event MouseLeftButtonDown]=[Action OpenLogDir]"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <RadioButton Grid.Row="0" Content="&#xe8f5;" FontSize="40"
                                     Width="150" Height="70" Padding="55,-2,0,0" GroupName="NaviGroup" ToolTip="登录"
                                     Style="{DynamicResource NavigateButtonStyle2}" IsEnabled="{Binding EnableButtons}"
                                     cal:Message.Attach="[Event Click] = [Action NavigatePage('LoginPageViewModel')]"/>
                        <Label Grid.Row="1" Content="{Binding HiveStatus, Converter={StaticResource HiveStatusToStringConvert}}"
                               FontSize="16" FontFamily="微软雅黑" FontWeight="Light"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0,0,0,2" Padding="0"
                               Background="{Binding HiveStatus, Converter={StaticResource HiveStatusToColorConvert}}"
                               cal:Message.Attach="[Event MouseLeftButtonDown] = [Action ChangeHiveState]"/>
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Top"  HorizontalAlignment="Right" Orientation="Horizontal" Background="Transparent">
                    <Menu Width="22" Height="22" Margin="0 0 0 5" IsEnabled="{Binding EnableButtons}">
                        <MenuItem Template="{DynamicResource MenuItemControlTemplate}" IsEnabled="{Binding EnableButtons}">
                            <MenuItem.Icon>
                                <fa5:SvgAwesome Icon="Regular_Bars" Foreground="White"/>
                            </MenuItem.Icon>
                            <MenuItem Header="{DynamicResource 系统设置}" FontSize="15" Padding="5" Template="{DynamicResource MenuItemControlTemplate_Right}" Width="150" 
                                           cal:Message.Attach="[Event Click]=[Action SystemConfigWindow]">
                                <MenuItem.Icon>
                                    <fa5:SvgAwesome Icon="Solid_Cog" Foreground="White"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                    <!--Window最小化-->
                    <TextBlock Width="22" Height="22" TextAlignment="Center" Margin="5 5 0 5" Style="{StaticResource WindowStateTextBlockStyle}"   
                                   cal:Message.Attach="[Event MouseDown]=[Action MinimizeWindow]">
                            <fa5:SvgAwesome Icon="Regular_WindowMinimize" Foreground="White" Width="16" Height="16"></fa5:SvgAwesome>
                    </TextBlock>
                    <!--Window界面最大化，还原-->
                    <TextBlock Width="22" Height="22" TextAlignment="Center" Margin="5 5 0 5" Style="{StaticResource WindowStateTextBlockStyle}"                                  
                                   cal:Message.Attach="[Event MouseDown] = [Action MaximizeWindow]">
                            <fa5:SvgAwesome Icon="Regular_WindowMaximize" Foreground="White" Width="16" Height="16"></fa5:SvgAwesome>
                    </TextBlock>
                    <!--关闭Window界面-->
                    <TextBlock  Width="22" Height="22"  TextAlignment="Center" Margin="5 5 5 5" Style="{StaticResource WindowStateTextBlockStyle}"
                                    cal:Message.Attach="[Event MouseDown] = [Action CloseWindow]">                               
                            <fa5:SvgAwesome Icon="Regular_WindowClose" Foreground="White" Width="16" Height="16"></fa5:SvgAwesome>
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"  Margin="0 4 0 0" >
                <!--不使用如下方式是因为会在切换页面时卡顿一下-->
                <!--<ContentControl Grid.Column="1" x:Name="ActiveItem"></ContentControl>-->
                <TabControl SelectedIndex="{Binding SelecetedIndex}" TabStripPlacement="Bottom" Margin="0 0 0 -30">
                    <!--这些itemHiveStatusToTopColorConvert的顺序应该与orderID保持一致-->
                    <TabItem Header="rbItemMainForm" Opacity="0" Visibility="Hidden" Background="Transparent">
                        <ContentControl x:Name="rbItemMainForm"></ContentControl>
                    </TabItem>
                    <TabItem Header="rbItemSetup" Opacity="0" Visibility="Hidden" Background="Transparent">
                        <ContentControl x:Name="rbItemSetup"></ContentControl>
                    </TabItem>
                    <TabItem Header="rbItemCCD" Opacity="0" Visibility="Hidden" Background="Transparent">
                        <ContentControl x:Name="rbItemCCD" ></ContentControl>
                    </TabItem>
                    <TabItem Header="rbItemAlarm" Opacity="0" Visibility="Hidden" Background="Transparent">
                        <ContentControl x:Name="rbItemAlarm"></ContentControl>
                    </TabItem>
                    <TabItem Header="rbItemProductivity" Opacity="0" Visibility="Hidden" Background="Transparent">
                        <ContentControl x:Name="rbItemProductivity"></ContentControl>
                    </TabItem>
                    <TabItem Header="rbItemLogin" Opacity="0" Visibility="Hidden" Background="Transparent">
                        <ContentControl x:Name="rbItemLogin"></ContentControl>
                    </TabItem>
                </TabControl>
            </Grid>

            <Grid Grid.Row="2" Background="LightGray">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <StatusBar Grid.Column="0" Foreground="{Binding StatusForeColor}" Background="LightGray" FontSize="15" Height="auto" VerticalAlignment="Center">
                    <StatusBarItem Content="{Binding UserStatus}"/>
                </StatusBar>
                <StatusBar Grid.Column="1" Background="LightGray" FontSize="15" Height="auto" VerticalAlignment="Center">
                    <StatusBarItem Content="{Binding RobotRealInfo}"/>
                </StatusBar>
                <StatusBar Grid.Column="2" Background="LightGray" FontSize="15" Height="auto" VerticalAlignment="Center">
                    <StatusBarItem Content="{Binding SoftRunDateTime}"/>
                </StatusBar>
                <StatusBar Grid.Column="3" Background="LightGray" FontSize="15" Height="auto" VerticalAlignment="Center">
                    <StatusBarItem Content="{Binding MachineStatus}"/>
                </StatusBar>
                <StatusBar Grid.Column="4" Background="LightGray" FontSize="15" Height="auto" VerticalAlignment="Center">
                    <StatusBarItem Content="{Binding LocalStatusInfo}"/>
                </StatusBar>
            </Grid>
        </Grid>
    </Border>
</Window>
