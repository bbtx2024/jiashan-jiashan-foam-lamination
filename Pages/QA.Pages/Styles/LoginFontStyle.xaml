<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <Style x:Key="LoginFont">
        <Setter Property="TextElement.FontFamily" Value="pack://WPFFrame:,,,/Resources/#FontAwesome" />
        <Setter Property="FrameworkElement.Width" Value="250"/>
        <Setter Property="FrameworkElement.Height" Value="250"/>
        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        <Setter Property="TextBlock.Padding" Value="0"/>
        <Setter Property="FrameworkElement.HorizontalAlignment" Value="Center"/>
        <Setter Property="FrameworkElement.VerticalAlignment" Value="Center"/>
        <Setter Property="TextBlock.FontSize" Value="200"/>
        <Setter Property="TextBlock.Foreground" Value= "#008d86" />
    </Style>

</ResourceDictionary>