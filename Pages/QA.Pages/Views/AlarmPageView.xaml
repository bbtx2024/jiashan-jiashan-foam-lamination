<UserControl x:Class="QA.Pages.Views.AlarmPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.Pages.Views"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid Background="White" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="White">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="{DynamicResource 开始时间}" FontSize="18" Height="auto"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <hc:DateTimePicker Grid.Column="1" Height="auto" FontSize="18"/>
                    <Label Grid.Column="3" Content="{DynamicResource 结束时间}" FontSize="18" Height="auto"
                           HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <hc:DateTimePicker Grid.Column="4" Height="auto" FontSize="18"/>
                    <Button Grid.Column="6" Content="{DynamicResource 查询}" FontSize="18" Height="auto"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Button Grid.Column="8" Content="{DynamicResource 导出}" FontSize="18" Height="auto"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="2" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <GroupBox Grid.Column="0" Header="{DynamicResource 当前报警}" FontSize="18">
                    <Border CornerRadius="4">
                        <ListView BorderThickness="0" ItemsSource="{Binding CurrentAlarmInfoModels}"
                                      hc:ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource 序号}" Width="60" DisplayMemberBinding="{Binding Index}"/>
                                    <GridViewColumn Header="{DynamicResource 级别}" Width="60" DisplayMemberBinding="{Binding AlarmLevel}"/>
                                    <GridViewColumn Header="{DynamicResource 模块}" Width="100" DisplayMemberBinding="{Binding AlarmModule}"/>
                                    <GridViewColumn Header="{DynamicResource 信息}" Width="300" DisplayMemberBinding="{Binding AlarmMsg}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </GroupBox>
                <GroupBox Grid.Column="2" Header="{DynamicResource 历史报警}" FontSize="18">
                    <Border CornerRadius="4">
                        <ListView BorderThickness="0" ItemsSource="{Binding HistoryAlarmInfoModels}"
                                      hc:ScrollViewer.HorizontalScrollBarVisibility="Auto" >
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="{DynamicResource 序号}" Width="60" DisplayMemberBinding="{Binding Index}"/>
                                    <GridViewColumn Header="{DynamicResource 级别}" Width="60" DisplayMemberBinding="{Binding AlarmLevel}"/>
                                    <GridViewColumn Header="{DynamicResource 模块}" Width="100" DisplayMemberBinding="{Binding AlarmModule}"/>
                                    <GridViewColumn Header="{DynamicResource 信息}" Width="300" DisplayMemberBinding="{Binding AlarmMsg}"/>
                                    <GridViewColumn Header="{DynamicResource 时间}" Width="230" DisplayMemberBinding="{Binding Datetime,StringFormat={}{0:yyyy-MM-dd HH:mm:ss.fff}}"/>
                                </GridView>
                            </ListView.View>
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource 清空历史记录}" cal:Message.Attach="[Event Click] = [Action ClearHistoryAlarm]"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                        </ListView>
                    </Border>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
