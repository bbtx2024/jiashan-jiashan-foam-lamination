<UserControl x:Class="QA.Pages.Views.SystemConfigPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.Pages.Views"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"  
             xmlns:uc="clr-namespace:QA.UserControls;assembly=QA.UserControls"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True" Margin="5,5,5,10">
        <StackPanel DockPanel.Dock="Bottom" Height="38" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content= "{DynamicResource 备份}" Background="#0088FF" FontFamily="微软雅黑" FontSize="18" Height="Auto" Width="180" Margin="20,0" VerticalAlignment="Stretch" 
                    cal:Message.Attach="[Event Click] = [Action BackupSysConfig]"/>
            <Button Content="{DynamicResource 确定}" Background="#008D86" FontFamily="微软雅黑" FontSize="18" Height="Auto" Width="180" Margin="20,0" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action ConfirmModifySysConfig]"/>
            <Button Content="{DynamicResource 取消}" Background="#BBFF0000" FontFamily="微软雅黑" FontSize="18" Height="Auto" Width="180" Margin="20,0" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action CancelModifySysConfig]"/>
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <TreeView x:Name="tv_SysConfig" Grid.Column="0" ItemsSource="{Binding SysConfigNodes}" Background="FloralWhite" BorderBrush="Gray" 
                      cal:Message.Attach="[Event SelectedItemChanged] = [Action SelectedNodeChanged(tv_SysConfig.SelectedItem)]">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding ChildNodes}">
                        <TextBlock Text="{Binding NodeName}" FontFamily="微软雅黑" FontSize="18"/>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <ContentControl Grid.Column="1" >
                <uc:PropertyGridView Grid.Column="1" SelectedObject="{Binding SelectedSysConfigNode.NodeObject}" PreviewMouseWheel="PropertyGridView_PreviewMouseWheel"/>
            </ContentControl>
        </Grid>
    </DockPanel>

</UserControl>
