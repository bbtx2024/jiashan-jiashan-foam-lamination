<UserControl x:Class="QA.Pages.OtherViews.Views.StatisticView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.Pages.OtherViews.Views"
             mc:Ignorable="d" 
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:convert="clr-namespace:QA.Business.Converts;assembly=QA.Business"
             d:DesignHeight="500" d:DesignWidth="500">

    <UserControl.Resources>
        <convert:PcsConvert x:Key="PcsConvert"/>
        <convert:FloatToPercentConvert x:Key="FloatToPercentConvert"/>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource 吸嘴使用次数}" BorderThickness="0" FontSize="18"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="0" Grid.Column="1" Content="{Binding Statistic.UseCountAll,Converter={StaticResource PcsConvert}}"
               BorderThickness="0" FontSize="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource 取料NG}" BorderThickness="0" FontSize="18"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="1" Grid.Column="1" Content="{Binding Statistic.SuckNgCountAll,Converter={StaticResource PcsConvert}}"
               BorderThickness="0" FontSize="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource 上视觉拍照NG}" BorderThickness="0" FontSize="18"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="2" Grid.Column="1" Content="{Binding Statistic.CamNgCount1,Converter={StaticResource PcsConvert}}"
               BorderThickness="0" FontSize="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="3" Grid.Column="0" Content="{DynamicResource 下视觉拍照NG}" BorderThickness="0" FontSize="18"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="3" Grid.Column="1" Content="{Binding Statistic.CamNgCount2,Converter={StaticResource PcsConvert}}"
               BorderThickness="0" FontSize="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <Label Grid.Row="4" Grid.Column="0" Content="{DynamicResource Tape良率}" BorderThickness="0" FontSize="18"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="4" Grid.Column="1" Content="{Binding Statistic.OkRateAll,Converter={StaticResource FloatToPercentConvert}}"
               BorderThickness="0" FontSize="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="5" Grid.Column="0" Content="{DynamicResource 运行时间}" BorderThickness="0" FontSize="18"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="5" Grid.Column="1" Content="{Binding Statistic.RunTimeStr}"
               BorderThickness="0" FontSize="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="6" Grid.Column="0" Content="{DynamicResource 待料时间}" BorderThickness="0" FontSize="18"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="6" Grid.Column="1" Content="{Binding Statistic.IdleTimeStr}"
               BorderThickness="0" FontSize="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="7" Grid.Column="0" Content="{DynamicResource 故障时间}" BorderThickness="0" FontSize="18"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="7" Grid.Column="1" Content="{Binding Statistic.ErrTimeStr}"
               BorderThickness="0" FontSize="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="8" Grid.Column="0" Content="{DynamicResource 报警总数}" BorderThickness="0" FontSize="18"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Label Grid.Row="8" Grid.Column="1" Content="{Binding Statistic.AlarmCountStr}"
               BorderThickness="0" FontSize="18" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Grid>
</UserControl>
