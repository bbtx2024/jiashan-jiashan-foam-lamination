<UserControl x:Class="QA.Pages.OtherViews.Views.FunctionIsEnabledView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.Pages.OtherViews.Views"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:convert="clr-namespace:QA.Business.Converts;assembly=QA.Business"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="450">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="/QA.Pages;component/Styles/GroupBoxStyle1.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="QuickGreen" Color="#008D86"></SolidColorBrush>
            <Thickness x:Key="Padding1">3</Thickness>

            <convert:PcsConvert x:Key="PcsConvert"></convert:PcsConvert>
            <convert:FloatToSecondConvert x:Key="FloatToSecondConvert"></convert:FloatToSecondConvert>
            <convert:FloatToPercentConvert x:Key="FloatToPercentConvert"></convert:FloatToPercentConvert>
            <convert:BoolToConnectStringConvert x:Key="BoolToConnectStringConvert"></convert:BoolToConnectStringConvert>
            <convert:BoolToBackgroundConvert x:Key="BoolToBackgroundConvert"></convert:BoolToBackgroundConvert>
            <convert:BoolToEnableStringConvert x:Key="BoolToEnableStringConvert"></convert:BoolToEnableStringConvert>
            <convert:PickOpportunityToBackgroundConvert x:Key="PickOpportunityToBackgroundConvert"></convert:PickOpportunityToBackgroundConvert>
            <convert:PickOpportunityToEnableStringConvert x:Key="PickOpportunityToEnableStringConvert"></convert:PickOpportunityToEnableStringConvert>
            <convert:OncePickNumToBackgroundConvert x:Key="OncePickNumToBackgroundConvert"></convert:OncePickNumToBackgroundConvert>
            <convert:OncePickNumToEnableStringConvert x:Key="OncePickNumToEnableStringConvert"></convert:OncePickNumToEnableStringConvert>

            <Style x:Key="MoveFont" TargetType="TextBlock">
                <Setter Property="TextBlock.FontFamily" Value="微软雅黑" />
                <Setter Property="TextBlock.Width" Value="100"/>
                <Setter Property="TextBlock.Height" Value="30"/>
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                <Setter Property="TextBlock.Padding" Value="2"/>
                <Setter Property="TextBlock.HorizontalAlignment" Value="Center"/>
                <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                <Setter Property="TextBlock.FontSize" Value="18"/>
                <Setter Property="TextBlock.Foreground" Value= "Black"/>
                <Style.Triggers>
                    <Trigger Property="TextBlock.IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#008D86"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="5"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource 取料时机}" FontFamily="微软雅黑" FontSize="18" Height="auto" 
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="0" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.PickOpportunity, Converter={StaticResource PickOpportunityToEnableStringConvert}}"
                    Background="{Binding Enable.PickOpportunity, Converter={StaticResource PickOpportunityToBackgroundConvert}}" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchPickOpportunity]"/>
            <Label Grid.Row="1" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource 取料Feeder}" FontFamily="微软雅黑" FontSize="18" Height="auto" 
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="1" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.FeederId}"
                    Background="#7D00FF00"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchFeederId]"/>

            <!--<Label Grid.Row="1" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource 同时取料数目}" FontFamily="微软雅黑" FontSize="18" Height="auto" 
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="1" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.OncePickNum, Converter={StaticResource OncePickNumToEnableStringConvert}}"
                    Background="{Binding Enable.OncePickNum, Converter={StaticResource OncePickNumToBackgroundConvert}}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchOncePickNum]"/>-->

            <Label Grid.Row="2" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource 保持平台无料}" FontFamily="微软雅黑" FontSize="18" Height="auto" 
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="2" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.KeepNoTapeOnFeeder, Converter={StaticResource BoolToEnableStringConvert}}"
                    Background="{Binding Enable.KeepNoTapeOnFeeder, Converter={StaticResource BoolToBackgroundConvert}}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchKeepNoTapeOnFeeder]"/>

            <Label Grid.Row="3" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource 复位自动清料}" FontFamily="微软雅黑" FontSize="18" Height="auto" 
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="3" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.AutoThrowTapesAfterReset, Converter={StaticResource BoolToEnableStringConvert}}"
                    Background="{Binding Enable.AutoThrowTapesAfterReset, Converter={StaticResource BoolToBackgroundConvert}}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchAutoThrowTapesAfterReset]"/>

            <Label Grid.Row="4" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource 1号吸嘴}" FontFamily="微软雅黑" FontSize="18" Height="auto"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="4" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.UseNozzle1, Converter={StaticResource BoolToEnableStringConvert}}"
                    Background="{Binding Enable.UseNozzle1, Converter={StaticResource BoolToBackgroundConvert}}" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchUseNozzle1]"/>

            <Label Grid.Row="5" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource 2号吸嘴}" FontFamily="微软雅黑" FontSize="18" Height="auto"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="5" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.UseNozzle2, Converter={StaticResource BoolToEnableStringConvert}}"
                    Background="{Binding Enable.UseNozzle2, Converter={StaticResource BoolToBackgroundConvert}}" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchUseNozzle2]"/>

            <!--<Label Grid.Row="6" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource 3号吸嘴}" FontFamily="微软雅黑" FontSize="18" Height="auto"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="6" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.UseNozzle3, Converter={StaticResource BoolToEnableStringConvert}}"
                    Background="{Binding Enable.UseNozzle3, Converter={StaticResource BoolToBackgroundConvert}}" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchUseNozzle3]"/>

            <Label Grid.Row="7" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource 4号吸嘴}" FontFamily="微软雅黑" FontSize="18" Height="auto"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="7" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.UseNozzle4, Converter={StaticResource BoolToEnableStringConvert}}"
                    Background="{Binding Enable.UseNozzle4, Converter={StaticResource BoolToBackgroundConvert}}" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchUseNozzle4]"/>-->
            <Label Grid.Row="8" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource Feeder盲取}" FontFamily="微软雅黑" FontSize="18" Height="auto"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="8" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.IsFeederCheck, Converter={StaticResource BoolToEnableStringConvert}}"
                    Background="{Binding Enable.IsFeederCheck, Converter={StaticResource BoolToBackgroundConvert}}" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchFeederGetCheck]"/>
            <Label Grid.Row="9" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource 相机只定位}" FontFamily="微软雅黑" FontSize="18" Height="auto"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="9" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.IsCDDCheck, Converter={StaticResource BoolToEnableStringConvert}}"
                    Background="{Binding Enable.IsCDDCheck, Converter={StaticResource BoolToBackgroundConvert}}" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchCDDGetCheck]"/>
            <Label Grid.Row="12" Grid.Column="0" Margin="0,5,0,0" Content="{DynamicResource 检测真空吸}" FontFamily="微软雅黑" FontSize="18" Height="auto"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Button Grid.Row="12" Grid.Column="2" Margin="0,5,0,0" FontFamily="微软雅黑" FontSize="18" Height="auto" IsEnabled="{Binding EnableButtons}"
                    Content="{Binding Enable.UseVacSucCheck, Converter={StaticResource BoolToEnableStringConvert}}"
                    Background="{Binding Enable.UseVacSucCheck, Converter={StaticResource BoolToBackgroundConvert}}" 
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action SwitchUseVacSucCheck]"/>

        </Grid>
    </Grid>
</UserControl>
