<UserControl x:Class="QA.Pages.OtherViews.Views.HiveChartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.Pages.OtherViews.Views"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"   
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:convert="clr-namespace:QA.Business.Converts;assembly=QA.Business"
             d:DesignHeight="800" d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="/QA.Pages;component/Styles/GroupBoxStyle1.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <convert:FloatToSecondConvert x:Key="FloatToSecondConvert"/>
            <convert:FloatToPercentConvert x:Key="FloatToPercentConvert"/>
            <convert:BoolToForegroundConvert x:Key="BoolToForegroundConvert"/>
            <convert:BoolToHiveConnectStrConvert x:Key="BoolToHiveConnectStrConvert"/>
            <convert:BoolToMesConnectStrConvert x:Key="BoolToMesConnectStrConvert"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="Machine State" Background="#d3d3d3">
                <lvc:CartesianChart Series="{Binding ToDayMachineStatusCollection}" LegendLocation="Top" Foreground="Black">
                    <lvc:CartesianChart.AxisX>
                        <lvc:Axis Title="{DynamicResource 日期}" Labels="{Binding TimeLabels}" FontSize="14"/>
                    </lvc:CartesianChart.AxisX>
                    <lvc:CartesianChart.AxisY>
                        <lvc:Axis Title="{DynamicResource 占比}" LabelFormatter="{Binding Formatter}" FontSize="14"/>
                    </lvc:CartesianChart.AxisY>
                </lvc:CartesianChart>
            </GroupBox>
            <GroupBox Grid.Row="2" Header="Error Statistics" Background="#d3d3d3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Content="{DynamicResource 起始日期}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <hc:DateTimePicker Grid.Column="1" SelectedDateTime="{Binding StartDate}"/>
                        <Label Grid.Column="2" Content="{DynamicResource 结束日期}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <hc:DateTimePicker Grid.Column="3" SelectedDateTime="{Binding EndDate}"/>
                        <Button Grid.Column="4" Content="{DynamicResource 查询}" x:Name="QueryHistoryError" Height="auto" FontSize="18"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                    <lvc:CartesianChart Grid.Row="3" Series="{Binding ChoiceTimeSpanErrorStatistics}" LegendLocation="Top" Foreground="Black">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="{DynamicResource 次数}" LabelFormatter="{Binding XFormatter}" FontSize="14"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="{DynamicResource 错误类型}" Labels="{Binding ErrorCodeTypeLabels}" FontSize="14"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </GroupBox>
        </Grid>
        <Grid Grid.Column="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <GroupBox Grid.Row="0" Header="I/O Summary" Background="#d3d3d3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0" Content="Input/Output:" FontSize="14" Background="Transparent" Height="Auto"
                               BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Label Grid.Row="0" Grid.Column="1" Content="{Binding InputOutput}" FontSize="14" Background="Transparent"  Height="Auto"
                               BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Label Grid.Row="1" Grid.Column="0" Content="Yield:" FontSize="14" Background="Transparent" Height="Auto"
                               BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Label Grid.Row="1" Grid.Column="1" Content="{Binding OkRate, Converter={StaticResource FloatToPercentConvert}}"
                               FontSize="14" Background="Transparent" Height="Auto"
                               BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Label Grid.Row="2" Grid.Column="0" Content="Pass/Fail:" FontSize="14" Background="Transparent" Height="Auto"
                               BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Label Grid.Row="2" Grid.Column="1" Content="{Binding PassFail}" FontSize="14" Background="Transparent" Height="Auto"
                               BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Label Grid.Row="3" Grid.Column="0" Content="UPH:" FontSize="14" Background="Transparent" Height="Auto"
                               BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Label Grid.Row="3" Grid.Column="1" Content="{Binding UPH}" FontSize="14" Background="Transparent" Height="Auto"
                               BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Label Grid.Row="4" Grid.Column="0" Content="CT:" FontSize="14" Background="Transparent" Height="Auto"
                               BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <Label Grid.Row="4" Grid.Column="1" Content="{Binding CTCircle, Converter={StaticResource FloatToSecondConvert}}"
                               FontSize="14" Background="Transparent" Height="Auto"
                               BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </GroupBox>
                <GroupBox Grid.Row="2" Header="Paramter DashBoard" Background="#d3d3d3">
                    <Border CornerRadius="4">
                        <hc:ScrollViewer>
                            <ListView BorderThickness="0" FontSize="14" ItemsSource="{Binding ParamDashBoard}" hc:ScrollViewer.HorizontalScrollBarVisibility="Auto" Background="#d3d3d3">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="KeyName" Width="140" DisplayMemberBinding="{Binding ParamName}"/>
                                        <GridViewColumn Header="Value" Width="100" DisplayMemberBinding="{Binding ParamValue}"/>
                                        <GridViewColumn Header="LSL" Width="100" DisplayMemberBinding="{Binding ParamLSL}"/>
                                        <GridViewColumn Header="USL" Width="100" DisplayMemberBinding="{Binding ParamUSL}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </hc:ScrollViewer>
                    </Border>
                </GroupBox>
                <GroupBox Grid.Row="4" Header="STN01 #1" Background="#d3d3d3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Label Content="Site:" FontWeight="Bold" FontSize="14" Background="Transparent" Height="Auto" BorderThickness="0"/>
                                <Label Content="{Binding Site}" FontSize="14" Background="Transparent" Height="Auto" BorderThickness="0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Label Content="Vendor:" FontWeight="Bold" FontSize="14" Background="Transparent" Height="Auto" BorderThickness="0"/>
                                <Label Content="{Binding Vendor}" FontSize="14" Background="Transparent" Height="Auto" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Label Content="SW Version:" FontWeight="Bold" FontSize="14" Background="Transparent" Height="Auto" BorderThickness="0"/>
                            <Label Content="{Binding SWVersion}" FontSize="14" Background="Transparent" Height="Auto" BorderThickness="0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Label Content="Main SW Path:" FontWeight="Bold" FontSize="14" Background="Transparent" Height="Auto" BorderThickness="0"/>
                            <Label Content="{Binding MainSWPath}" FontSize="14" Background="Transparent" Height="Auto" BorderThickness="0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Orientation="Horizontal">
                            <Label Content="MS__Hash:" FontWeight="Bold" FontSize="14" Background="Transparent" Height="Auto" BorderThickness="0"/>
                            <Label Content="{Binding MSHash}" FontSize="14" Background="Transparent" Foreground="{Binding MSHashBG}" Height="Auto" BorderThickness="0"/>
                        </StackPanel>
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="1" Content="{Binding IsHiveConnected, Converter={StaticResource BoolToHiveConnectStrConvert}}"
                                   Foreground="{Binding IsHiveConnected, Converter={StaticResource BoolToForegroundConvert}}"
                                   FontSize="14" Background="Transparent" Height="Auto" BorderThickness="0"/>
                            <Label Grid.Column="3" Content="{Binding IsMesConnected, Converter={StaticResource BoolToMesConnectStrConvert}}"
                                   Foreground="{Binding IsMesConnected, Converter={StaticResource BoolToForegroundConvert}}"
                                   FontSize="14" Background="Transparent" Height="Auto" BorderThickness="0"/>
                        </Grid>
                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="Machine Log" FontWeight="Bold" FontSize="16" Background="DimGray" Foreground="White"
                                    Height="Auto" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    cal:Message.Attach="[Event Click] = [Action OpenDialog('MachineLog')]"/>
                            <Button Grid.Column="3" Content="Hive Log" FontWeight="Bold" FontSize="16" Background="DimGray" Foreground="White"
                                    Height="Auto" BorderThickness="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    cal:Message.Attach="[Event Click] = [Action OpenDialog('HiveLog')]"/>
                        </Grid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
