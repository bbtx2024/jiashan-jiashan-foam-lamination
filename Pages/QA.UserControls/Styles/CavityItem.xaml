<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:hc="https://handyorg.github.io/handycontrol"
                    xmlns:s="clr-namespace:QA.UserControls.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="SizeChrome.xaml"></ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <ControlTemplate TargetType="{x:Type s:MoveThumb}" x:Key="MoveThumbTemplate">
        <Rectangle Fill="Transparent"></Rectangle>
    </ControlTemplate>

    <Style TargetType="{x:Type s:CavityItem}">
        <Setter Property="SnapsToDevicePixels" Value="True"></Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"></Setter>
        <Setter Property="MinHeight" Value="50"></Setter>
        <Setter Property="MinWidth" Value="50"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type s:CavityItem}">
                    <Grid DataContext="{Binding RelativeSource={RelativeSource TemplatedParent},Path=.}">
                        <s:MoveThumb Template="{DynamicResource MoveThumbTemplate}" x:Name="PART_MoveThumb"></s:MoveThumb>
                        <ContentPresenter Content="{TemplateBinding ContentControl.Content}" Margin="{TemplateBinding Padding}" x:Name="PART_ContentPresenter"></ContentPresenter>
                        <s:CavityItemDecorator  x:Name="PART_DesignerItemDecorator"></s:CavityItemDecorator>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="PART_DesignerItemDecorator" Property="ShowDecorator" Value="True" ></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>