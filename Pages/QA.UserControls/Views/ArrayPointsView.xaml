<UserControl x:Class="QA.UserControls.Views.ArrayPointsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.UserControls.Views"
             mc:Ignorable="d"
             xmlns:hc="https://handyorg.github.io/handycontrol" 
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:convert="clr-namespace:QA.UserControls.Converters"
             d:DesignHeight="470" d:DesignWidth="800" Height="470" Width="800" Background="AliceBlue" 
             FontFamily="微软雅黑" FontSize="18">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="/QA.UserControls;component/Styles/RadioThemeStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- 拍照顺序 -->
        <Label Grid.Row="0" Content="选择拍照顺序阵列类型（将按此顺序生成各个点位）" FontSize="18" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left"/>
        <Grid Grid.Row="1" Height="70">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RadioButton Grid.Column="0" Content="横向"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{DynamicResource RadioThemeColor}"
                         cal:Message.Attach="[Event Click] = [Action ChangeAddArrayType('Row')]" IsChecked="{Binding AddTypeRow}"/>
            <RadioButton Grid.Column="2" Content="纵向"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{DynamicResource RadioThemeColor}"
                         cal:Message.Attach="[Event Click] = [Action ChangeAddArrayType('Column')]" IsChecked="{Binding AddTypeColumn}"/>
            <RadioButton Grid.Column="4" Content="横向链式"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{DynamicResource RadioThemeColor}"
                         cal:Message.Attach="[Event Click] = [Action ChangeAddArrayType('RowChain')]" IsChecked="{Binding AddTypeRowChain}"/>
            <RadioButton Grid.Column="6" Content="纵向链式"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{DynamicResource RadioThemeColor}"
                         cal:Message.Attach="[Event Click] = [Action ChangeAddArrayType('ColumnChain')]" IsChecked="{Binding AddTypeColumnChain}"/>
        </Grid>
        <!-- 序号顺序 -->
        <Label Grid.Row="2" Content="选择序号顺序阵列类型（将按此顺序生成穴位号或吸嘴号）" FontSize="18" BorderThickness="0" Background="Transparent" HorizontalAlignment="Left"/>
        <Grid Grid.Row="3" Height="70">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <RadioButton Grid.Column="0" Content="横向"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{DynamicResource RadioThemeColor}"
                         cal:Message.Attach="[Event Click] = [Action ChangeIdxArrayType('Row')]" IsChecked="{Binding IdxTypeRow}"/>
            <RadioButton Grid.Column="2" Content="纵向"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{DynamicResource RadioThemeColor}"
                         cal:Message.Attach="[Event Click] = [Action ChangeIdxArrayType('Column')]" IsChecked="{Binding IdxTypeColumn}"/>
            <RadioButton Grid.Column="4" Content="横向链式"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{DynamicResource RadioThemeColor}"
                         cal:Message.Attach="[Event Click] = [Action ChangeIdxArrayType('RowChain')]" IsChecked="{Binding IdxTypeRowChain}"/>
            <RadioButton Grid.Column="6" Content="纵向链式"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{DynamicResource RadioThemeColor}"
                         cal:Message.Attach="[Event Click] = [Action ChangeIdxArrayType('ColumnChain')]" IsChecked="{Binding IdxTypeColumnChain}"/>
        </Grid>
        <!-- 行数列数 -->
        <Label Grid.Row="4" Content="输入阵列行数和列数" FontSize="18" BorderThickness="0" Background="Transparent" 
               HorizontalAlignment="Left"/>
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="行数"  Background="#DDDDDD" HorizontalAlignment="Stretch"/>
            <hc:NumericUpDown Grid.Column="2" Minimum="1" Maximum="10" Value="{Binding RowCount}" HorizontalContentAlignment="Center"/>
            <Label Grid.Column="4" Content="列数"  Background="#DDDDDD" HorizontalAlignment="Stretch"/>
            <hc:NumericUpDown Grid.Column="6" Minimum="1" Maximum="10" Value="{Binding ColumnCount}" HorizontalContentAlignment="Center"/>
        </Grid>
        <!-- 起点终点坐标 -->
        <Label Grid.Row="6" Content="输入起点和终点坐标" FontSize="18" BorderThickness="0" Background="Transparent" 
               HorizontalAlignment="Left"/>
        <Grid Grid.Row="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="起点X"  Background="#DDDDDD" HorizontalAlignment="Stretch"/>
            <hc:NumericUpDown Grid.Row="0" Grid.Column="2" DecimalPlaces="2" Value="{Binding StartX}" HorizontalContentAlignment="Center" Style="{StaticResource NumericUpDownPlus}"/>
            <Label Grid.Row="0" Grid.Column="4" Content="起点Y"  Background="#DDDDDD" HorizontalAlignment="Stretch"/>
            <hc:NumericUpDown Grid.Row="0" Grid.Column="6" DecimalPlaces="2" Value="{Binding StartY}" HorizontalContentAlignment="Center" Style="{StaticResource NumericUpDownPlus}"/>
            <Label Grid.Row="2" Grid.Column="0" Content="终点X"  Background="#DDDDDD" HorizontalAlignment="Stretch"/>
            <hc:NumericUpDown Grid.Row="2" Grid.Column="2" DecimalPlaces="2" Value="{Binding EndX}" HorizontalContentAlignment="Center" Style="{StaticResource NumericUpDownPlus}"/>
            <Label Grid.Row="2" Grid.Column="4" Content="终点Y"  Background="#DDDDDD" HorizontalAlignment="Stretch"/>
            <hc:NumericUpDown Grid.Row="2" Grid.Column="6" DecimalPlaces="2" Value="{Binding EndY}" HorizontalContentAlignment="Center" Style="{StaticResource NumericUpDownPlus}"/>
        </Grid>
        <!-- 确定取消按钮 -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Button x:Name="Confirm" Content="确定" Width="200" Height="40" Margin="0,0,20,0"
                    FontFamily="微软雅黑" FontSize="20" Background="#FF008D86"
                    cal:Message.Attach="[Event Click] = [Action ConfirmClick]"/>
            <Button x:Name="Cancel" Content="取消"  Width="200" Height="40"
                    FontFamily="微软雅黑" FontSize="20" Background="#BBFF0000"
                    cal:Message.Attach="[Event Click] = [Action CancelClick]"/>
        </StackPanel>
    </Grid>
</UserControl>
