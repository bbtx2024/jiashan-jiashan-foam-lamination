<UserControl x:Class="QA.UserControls.Views.ChangeHiveState2View"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cal="http://www.caliburnproject.org"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800" MinWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="/QA.Pages;component/Styles/GroupBoxStyle1.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="QuickGreen" Color="#008D86"></SolidColorBrush>
            <Thickness x:Key="Padding1">3</Thickness>

            <Style x:Key="MoveFont" TargetType="TextBlock">
                <Setter Property="TextBlock.FontFamily" Value="微软雅黑" />
                <Setter Property="TextBlock.Width" Value="100"/>
                <Setter Property="TextBlock.Height" Value="30"/>
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                <Setter Property="TextBlock.Padding" Value="2"/>
                <Setter Property="TextBlock.HorizontalAlignment" Value="Center"/>
                <Setter Property="TextBlock.VerticalAlignment" Value="Center"/>
                <Setter Property="TextBlock.FontSize" Value="18"/>
                <Setter Property="TextBlock.Foreground" Value= "Black"/>
                <Style.Triggers>
                    <Trigger Property="TextBlock.IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#008D86"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent" Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GroupBox Grid.Column="0" Header="计划停机" Background="#d3d3d3" FontSize="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="日常保养" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStatePlannedDT(1)]"/>

                <Button Grid.Row="2" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="压力测试" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStatePlannedDT(5)]"/>

                <Button Grid.Row="4" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="更换消耗品" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStatePlannedDT(7)]"/>

                <Button Grid.Row="6" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="更换物料" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStatePlannedDT(8)]"/>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Column="2" Header="手动宕机" Background="#d3d3d3" FontSize="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="5"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <Button Grid.Row="0" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="扫码异常" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStateDowntime('T01IPOO-01-03')]"/>

                <Button Grid.Row="2" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="MES异常" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStateDowntime('X01IPH5-01-03')]"/>

                <Button Grid.Row="4" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="视觉异常" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStateDowntime('V01VSDV-01-03')]"/>

                <Button Grid.Row="6" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="压力异常" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStateDowntime('S01SSSL-01-03')]"/>

                <Button Grid.Row="8" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="气缸异常" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStateDowntime('C02PNCY-01-03')]"/>

                <Button Grid.Row="10" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="载具异常" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStateDowntime('M02PLH1-01-03')]"/>

                <Button Grid.Row="12" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="真空异常" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStateDowntime('U01VGVV-01-03')]"/>

                <Button Grid.Row="14" FontFamily="微软雅黑" FontSize="18" Height="auto"
                Content="急停" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                cal:Message.Attach="[Event Click] = [Action ChangeHiveStateDowntime('F01ESOO-01-03')]"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
