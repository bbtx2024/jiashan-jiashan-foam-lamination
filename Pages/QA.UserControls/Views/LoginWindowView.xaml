<UserControl x:Class="QA.UserControls.Views.LoginWindowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.UserControls.Views"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol" 
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:convert="clr-namespace:QA.Business.Converts;assembly=QA.Business"
             d:DesignHeight="450" d:DesignWidth="800" Height="500" Width="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
                <ResourceDictionary Source="/QA.UserControls;component/Styles/LoginFontStyle.xaml"></ResourceDictionary>
                <ResourceDictionary Source="/QA.UserControls;component/Styles/TextPasswordStyle.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <convert:BoolToVisibleHiddenConvert x:Key="BoolToVisibleHiddenConvert"></convert:BoolToVisibleHiddenConvert>
            <convert:UserInfoToUserNameConvert x:Key="UserInfoToUserNameConvert"></convert:UserInfoToUserNameConvert>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="AliceBlue" FocusManager.FocusedElement="{Binding ElementName=tbxPassword}">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="4*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="&#xF2BC;" Style="{DynamicResource LoginFont}" Padding="0,80,0,0"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Grid Visibility="{Binding CommonLoginVisiable, Converter={StaticResource BoolToVisibleHiddenConvert}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="11*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="1" Content="{DynamicResource 用户：}" MinWidth="130"
                                   Background="Transparent" BorderThickness="0" FontSize="18"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            <ComboBox Grid.Column="2" FontSize="18"
                                      ItemsSource="{Binding UserInfos}" DisplayMemberPath="UserName"
                                      Text="{Binding UserName}" SelectedIndex="{Binding UserIndex}"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="11*"/>
                            </Grid.ColumnDefinitions>
                            <Label Grid.Column="1" Content="{DynamicResource 密码：}" MinWidth="130"
                                   Background="Transparent" BorderThickness="0" FontSize="18" HorizontalAlignment="Center"/>
                            <TextBox x:Name="tbxPassword" Grid.Column="2" Height="auto" Style="{StaticResource TxtPwd}"
                                     Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalContentAlignment="Center" HorizontalAlignment="Stretch"
                                     cal:Message.Attach="[Event KeyDown] = [Action HandleInput($eventArgs)]"/>
                        </Grid>
                    </Grid>
                    <Grid Visibility="{Binding BC750LoginVisiable, Converter={StaticResource BoolToVisibleHiddenConvert}}">
                        <Label Content="请刷卡！" FontSize="28" Background="AliceBlue" BorderThickness="0"/>
                    </Grid>
                </Grid>
                <Grid Grid.Row="3">
                    <Button Content="{DynamicResource 确定}" FontSize="18" Width="180" Height="Auto" Background="#FF008D86"
                            Margin="0,0,230,30" HorizontalAlignment="Right"
                            Visibility="{Binding CommonLoginVisiable, Converter={StaticResource BoolToVisibleHiddenConvert}}"
                            cal:Message.Attach="[Event Click] = [Action DoLogin]"/>
                    <Button Content="{DynamicResource 取消}" FontSize="18" Width="180" Height="Auto" Background="#BBFF0000"
                            Margin="0,0,40,30" HorizontalAlignment="Right"
                            cal:Message.Attach="[Event Click] = [Action Cancel]"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
