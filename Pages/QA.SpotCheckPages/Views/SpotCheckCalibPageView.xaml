<UserControl x:Class="QA.SpotCheckPages.Views.SpotCheckCalibPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoftd:\程序\fa07-贴膜1npi-0203\pages\qa.spotcheckpages\views\spotcheckcalibpageview.xaml
d:\程序\fa07-贴膜1npi-0203\pages\qa.spotcheckpages\views\spotcheckcalibpageview.xaml.cs
.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:local="clr-namespace:QA.SpotCheckPages.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LstBox" TargetType="ListBox">
                <!--<Setter Property="TextBlock.Width" Value="100"/>
                <Setter Property="TextBlock.Height" Value="100"/>-->
                <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                             
                <Setter Property="ListBox.FontSize" Value="14"/>
                <Setter Property="ListBox.Foreground" Value= "#008d8c"/>
                <Style.Triggers>
                    <Trigger Property="ListBox.SelectedItem" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="#008D86"/>
                    </Trigger>
                </Style.Triggers>
            </Style>


        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!--Grid.ColumnSpan="2"-->
        <ListBox x:Name="Items" Grid.Column="0" Margin="0 0 0 0" BorderThickness="0" IsEnabled="False" Style="{DynamicResource LstBox}">
            <ListBox.ItemTemplate  >
                <DataTemplate>
                    <TextBlock  Text="{Binding DisplayName}" FontSize="18"   Margin="5" Padding="5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            <!--NavigationUIVisibility="Hidden" Grid.ColumnSpan="2"-->
            <Frame x:Name="ActiveItem"  Grid.Row="0" NavigationUIVisibility="Hidden"  />
            <StackPanel Orientation="Horizontal" Grid.Row="1" FlowDirection="RightToLeft">
                <Button x:Name="NextStep" IsEnabled="{Binding IsNextStepEnabled}"  Content="{DynamicResource 下一步}" Height="auto" Width="120" Margin="10,0,10,0" FontSize="18"></Button>
                <Button x:Name="UpStep" IsEnabled="{Binding IsUpStepEnabled}" Content="{DynamicResource 上一步}" Height="auto" Width="120" Margin="10,0,10,0" FontSize="18"></Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
