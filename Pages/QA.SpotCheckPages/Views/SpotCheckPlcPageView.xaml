<UserControl x:Class="QA.SpotCheckPages.Views.SpotCheckPlcPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:QA.SpotCheckPages.Views"
             mc:Ignorable="d" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QA.Pages;component/Styles/DataGridStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="AliceBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!--<RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>-->
        </Grid.RowDefinitions>

        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,3">
            <Button Content="{DynamicResource 刷新读取地址}" FontSize="18" Height="Auto" HorizontalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action RefreshReadAddr]"/>
            <Button Content="{DynamicResource 刷新写入地址}" FontSize="18" Height="Auto" HorizontalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action RefreshWriteAddr]"/>
            <Button Content="{DynamicResource 重新连接PLC}" FontSize="18" Height="Auto" HorizontalAlignment="Stretch"
                    cal:Message.Attach="[Event Click] = [Action ReconnectPLC]"/>
        </UniformGrid>

        <UniformGrid Grid.Row="1" Columns="2">

            <!--PLC读取地址-->
            <DataGrid Grid.Row="1" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"         
                  CanUserResizeRows="False" CanUserResizeColumns="False" AlternationCount="2" ColumnWidth="*" FontSize="18"
                  CanUserAddRows="False"
                  CellStyle="{StaticResource myDataGridCellStyle}"          
                  RowStyle="{StaticResource myDataGridRowStyle}"       
                  ColumnHeaderStyle="{StaticResource myDataGridColumnHeader}"             
                  Style="{StaticResource myDataGridStyle}"        
                  ItemsSource="{Binding Model.ReadAddrValues}"     
                  SelectedItem="{Binding Model.SltReadAddrValue}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource 读取地址}" Binding="{Binding Addr}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <!--PLC写入地址-->
            <DataGrid Grid.Row="3" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"         
                  CanUserResizeRows="False" CanUserResizeColumns="False" AlternationCount="2" ColumnWidth="*" FontSize="18"
                  CanUserAddRows="False"
                  CellStyle="{StaticResource myDataGridCellStyle}"          
                  RowStyle="{StaticResource myDataGridRowStyle}"       
                  ColumnHeaderStyle="{StaticResource myDataGridColumnHeader}"             
                  Style="{StaticResource myDataGridStyle}"        
                  ItemsSource="{Binding Model.WriteAddrValues}"     
                  SelectedItem="{Binding Model.SltWriteAddrValue}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource 写入地址}" Binding="{Binding Addr}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                </DataGrid.Columns>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource 写入PLC当前地址}" cal:Message.Attach="[Event Click] = [Action WritePlcCurAddr]"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>

        </UniformGrid>

    </Grid>
</UserControl>
