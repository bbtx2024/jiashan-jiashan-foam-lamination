<UserControl x:Class="QA.SpotCheckPages.Calibration.Views.NinePointCalibView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:cal="http://www.caliburnproject.org"
             xmlns:local="clr-namespace:QA.SpotCheckPages.Calibration.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinQuick.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="White">
        <TabControl>
            <TabItem Header="{DynamicResource 1号相机标定}" Width="180" Height="auto" FontSize="18">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="{DynamicResource 设置上相机9点标定1号坐标}" FontSize="18" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(1)]"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource 空移上相机9点标定1号坐标}" FontSize="18"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(1)]"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding CurCamNo1NineCalibPos_1}" FontSize="18"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button Grid.Row="2" Grid.Column="0" Content="{DynamicResource 设置上相机9点标定2号坐标}" FontSize="18" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(2)]"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource 空移上相机9点标定2号坐标}" FontSize="18"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(2)]"/>
                    <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding CurCamNo1NineCalibPos_2}" FontSize="18"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button Grid.Row="4" Grid.Column="0" Content="{DynamicResource 设置上相机9点标定3号坐标}" FontSize="18" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(3)]"/>
                    <Button Grid.Row="4" Grid.Column="2" Content="{DynamicResource 空移上相机9点标定3号坐标}" FontSize="18"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(3)]"/>
                    <TextBlock Grid.Row="4" Grid.Column="4" Text="{Binding CurCamNo1NineCalibPos_3}" FontSize="18"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button Grid.Row="6" Grid.Column="0" Content="{DynamicResource 设置上相机9点标定4号坐标}" FontSize="18" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(4)]"/>
                    <Button Grid.Row="6" Grid.Column="2" Content="{DynamicResource 空移上相机9点标定4号坐标}" FontSize="18"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(4)]"/>
                    <TextBlock Grid.Row="6" Grid.Column="4" Text="{Binding CurCamNo1NineCalibPos_4}" FontSize="18"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button Grid.Row="8" Grid.Column="0" Content="{DynamicResource 设置上相机9点标定5号坐标}" FontSize="18" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(5)]"/>
                    <Button Grid.Row="8" Grid.Column="2" Content="{DynamicResource 空移上相机9点标定5号坐标}" FontSize="18"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(5)]"/>
                    <TextBlock Grid.Row="8" Grid.Column="4" Text="{Binding CurCamNo1NineCalibPos_5}" FontSize="18"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button Grid.Row="10" Grid.Column="0" Content="{DynamicResource 设置上相机9点标定6号坐标}" FontSize="18" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(6)]"/>
                    <Button Grid.Row="10" Grid.Column="2" Content="{DynamicResource 空移上相机9点标定6号坐标}" FontSize="18"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(6)]"/>
                    <TextBlock Grid.Row="10" Grid.Column="4" Text="{Binding CurCamNo1NineCalibPos_6}" FontSize="18"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button Grid.Row="12" Grid.Column="0" Content="{DynamicResource 设置上相机9点标定7号坐标}" FontSize="18" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(7)]"/>
                    <Button Grid.Row="12" Grid.Column="2" Content="{DynamicResource 空移上相机9点标定7号坐标}" FontSize="18"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(7)]"/>
                    <TextBlock Grid.Row="12" Grid.Column="4" Text="{Binding CurCamNo1NineCalibPos_7}" FontSize="18"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button Grid.Row="14" Grid.Column="0" Content="{DynamicResource 设置上相机9点标定8号坐标}" FontSize="18" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(8)]"/>
                    <Button Grid.Row="14" Grid.Column="2" Content="{DynamicResource 空移上相机9点标定8号坐标}" FontSize="18"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(8)]"/>
                    <TextBlock Grid.Row="14" Grid.Column="4" Text="{Binding CurCamNo1NineCalibPos_8}" FontSize="18"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button Grid.Row="16" Grid.Column="0" Content="{DynamicResource 设置上相机9点标定9号坐标}" FontSize="18" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibNinePointPosToUpCameraNo1(9)]"/>
                    <Button Grid.Row="16" Grid.Column="2" Content="{DynamicResource 空移上相机9点标定9号坐标}" FontSize="18"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibNinePointPosToUpCameraNo1(9)]"/>
                    <TextBlock Grid.Row="16" Grid.Column="4" Text="{Binding CurCamNo1NineCalibPos_9}" FontSize="18"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button Grid.Row="18" Grid.Column="0" Content="{DynamicResource 执行上相机9点标定}" FontSize="18" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action CalibNinePoint]"/>
                </Grid>
            </TabItem>
            <TabItem Header="{DynamicResource 2号相机标定}" Width="180" Height="auto" FontSize="18">
                <Grid Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="{DynamicResource 设置2号吸嘴下相机标定坐标}" FontSize="15" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibElevenPointPosToDownCamera_Nozzle(2)]"/>
                    <Button Grid.Row="0" Grid.Column="2" Content="{DynamicResource 空移2号吸嘴下相机标定坐标}" FontSize="15"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibElevenPointPosToDownCamera_Nozzle(2)]"/>
                    <Button Grid.Row="0" Grid.Column="4" Content="{DynamicResource 执行2号吸嘴下相机11点标定}" FontSize="15"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action CalibElevenPoint_Nozzle(2)]"/>
                    <TextBlock Grid.Row="0" Grid.Column="6" Text="{Binding CurCamNo2NozzleNo2Pos}" FontSize="15"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <Button Grid.Row="2" Grid.Column="0" Content="{DynamicResource 设置3号吸嘴下相机标定坐标}" FontSize="15" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibElevenPointPosToDownCamera_Nozzle(3)]"/>
                    <Button Grid.Row="2" Grid.Column="2" Content="{DynamicResource 空移3号吸嘴下相机标定坐标}" FontSize="15"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibElevenPointPosToDownCamera_Nozzle(3)]"/>
                    <Button Grid.Row="2" Grid.Column="4" Content="{DynamicResource 执行3号吸嘴下相机11点标定}" FontSize="15"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action CalibElevenPoint_Nozzle(3)]"/>
                    <TextBlock Grid.Row="2" Grid.Column="6" Text="{Binding CurCamNo2NozzleNo3Pos}" FontSize="15"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <Button Grid.Row="4" Grid.Column="0" Content="{DynamicResource 设置4号吸嘴下相机标定坐标}" FontSize="15" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action SetCalibElevenPointPosToDownCamera_Nozzle(4)]"/>
                    <Button Grid.Row="4" Grid.Column="2" Content="{DynamicResource 空移4号吸嘴下相机标定坐标}" FontSize="15"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action MoveSpaceCalibElevenPointPosToDownCamera_Nozzle(4)]"/>
                    <Button Grid.Row="4" Grid.Column="4" Content="{DynamicResource 执行4号吸嘴下相机11点标定}" FontSize="15"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action CalibElevenPoint_Nozzle(4)]"/>
                    <TextBlock Grid.Row="4" Grid.Column="6" Text="{Binding CurCamNo2NozzleNo4Pos}" FontSize="15"
                               Width="auto" Height="auto" HorizontalAlignment="Left" VerticalAlignment="Center"/>

                    <Button Grid.Row="6" Grid.Column="0" Content="{DynamicResource 标定结束}" FontSize="15" IsEnabled="{Binding EnableButtons}"
                            Height="auto" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            Style="{DynamicResource ButtonPrimary}" cal:Message.Attach="[Event Click] = [Action EndCalibration]"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
